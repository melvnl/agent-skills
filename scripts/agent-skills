#!/usr/bin/env bash
# agent-skills: install, update and check this repository's Claude Code plugins.
# A thin wrapper over `claude plugin ...`; it never edits Claude Code settings files directly.
#
#   agent-skills profiles                         list profiles and their plugins
#   agent-skills install [--profile P]... [--scope user|project|local] [--source DIR_OR_REPO]
#                                                 register the marketplace (if needed) and install plugins;
#                                                 dependencies (e.g. fintech -> backend, observability, security)
#                                                 are installed by Claude Code automatically. Default profile: core.
#   agent-skills update                           refresh the marketplace and update installed melvin-* plugins
#   agent-skills doctor                           check prerequisites, registration, installed plugins, validators
#   agent-skills validate                         run the repository validator and hook tests (from a checkout)
#
# Environment: AGENT_SKILLS_SOURCE overrides the marketplace source (default: this checkout).
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MARKETPLACE="melvin-skills"
PROFILES_FILE="$REPO/scripts/profiles.json"

die() { echo "agent-skills: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "'$1' not found on PATH"; }

profile_plugins() { # profile_plugins <name>... -> one plugin per line (deduplicated, validated)
  python3 - "$PROFILES_FILE" "$REPO/.claude-plugin/marketplace.json" "$@" <<'PY'
import json, sys
profiles = json.load(open(sys.argv[1]))
known = {p["name"] for p in json.load(open(sys.argv[2]))["plugins"]}
for name, plugins in profiles.items():
    missing = [p for p in plugins if p not in known]
    if missing:
        sys.exit(f"profile '{name}' names unknown plugins: {missing}")
seen = []
for name in sys.argv[3:]:
    if name not in profiles:
        sys.exit(f"unknown profile '{name}' (choose from: {', '.join(profiles)})")
    seen += [p for p in profiles[name] if p not in seen]
print("\n".join(seen))
PY
}

marketplace_registered() {
  claude plugin marketplace list --json 2>/dev/null | python3 -c \
    "import json,sys; sys.exit(0 if any(m.get('name')=='$MARKETPLACE' for m in json.load(sys.stdin)) else 1)"
}

installed_plugins() { # one "id<TAB>scope<TAB>enabled<TAB>version" per melvin plugin
  claude plugin list --json 2>/dev/null | python3 -c "
import json, sys
for p in json.load(sys.stdin):
    if p.get('id', '').endswith('@$MARKETPLACE'):
        print('\t'.join([p['id'], p.get('scope', '?'), str(p.get('enabled')), p.get('version', '?')]))"
}

cmd_profiles() {
  python3 - "$PROFILES_FILE" <<'PY'
import json, sys
for name, plugins in json.load(open(sys.argv[1])).items():
    print(f"{name:<14} {', '.join(plugins)}")
PY
}

cmd_install() {
  local profiles=() scope="user" source="${AGENT_SKILLS_SOURCE:-$REPO}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) profiles+=("${2:?--profile needs a value}"); shift 2 ;;
      --scope) scope="${2:?--scope needs a value}"; shift 2 ;;
      --source) source="${2:?--source needs a value}"; shift 2 ;;
      *) die "unknown install option: $1" ;;
    esac
  done
  [ ${#profiles[@]} -eq 0 ] && profiles=(core)
  case "$scope" in user|project|local) ;; *) die "scope must be user, project or local" ;; esac
  need claude; need python3
  local plugins; plugins="$(profile_plugins "${profiles[@]}")" || exit 1
  if marketplace_registered; then
    echo "marketplace $MARKETPLACE already registered"
  else
    echo "registering marketplace $MARKETPLACE from $source"
    claude plugin marketplace add "$source"
  fi
  while IFS= read -r plugin; do
    [ -n "$plugin" ] || continue
    echo "installing $plugin ($scope)"
    claude plugin install "$plugin@$MARKETPLACE" --scope "$scope"
  done <<< "$plugins"
  if grep -q melvin-guardrails <<< "$plugins"; then
    echo "note: guardrail hooks that run project commands stay off until you enable 'run_project_commands':"
    echo "      claude plugin configure melvin-guardrails@$MARKETPLACE"
  fi
  echo "restart Claude Code sessions to load new plugins"
}

cmd_update() {
  need claude; need python3
  marketplace_registered || die "marketplace $MARKETPLACE is not registered; run: agent-skills install"
  claude plugin marketplace update "$MARKETPLACE"
  local found=0
  while IFS=$'\t' read -r id scope _enabled _version; do
    [ -n "$id" ] || continue
    found=1
    claude plugin update "$id" --scope "$scope"
  done <<< "$(installed_plugins)"
  [ "$found" -eq 1 ] || echo "no $MARKETPLACE plugins installed"
}

cmd_doctor() {
  local problems=0
  check() { if eval "$2" >/dev/null 2>&1; then echo "ok    $1"; else echo "FAIL  $1${3:+ ($3)}"; problems=$((problems+1)); fi; }
  check "claude CLI on PATH" "command -v claude" "install Claude Code"
  check "python3 >= 3.8 (guardrail hooks)" "python3 -c 'import sys; sys.exit(sys.version_info < (3, 8))'"
  check "git on PATH" "command -v git"
  if command -v claude >/dev/null 2>&1; then
    check "marketplace $MARKETPLACE registered" "marketplace_registered" "run: agent-skills install"
    local rows; rows="$(installed_plugins || true)"
    if [ -n "$rows" ]; then
      while IFS=$'\t' read -r id scope enabled version; do
        if [ "$enabled" = "True" ]; then echo "ok    $id $version ($scope)"; else echo "WARN  $id $version ($scope) is disabled"; fi
      done <<< "$rows"
    else
      echo "WARN  no $MARKETPLACE plugins installed"
    fi
  fi
  if [ -f "$REPO/scripts/validate.py" ]; then
    check "repository validator" "python3 -I '$REPO/scripts/validate.py' -q" "run: python3 scripts/validate.py"
    check "guardrail hook tests" "python3 -m unittest discover -s '$REPO/plugins/guardrails/tests' -q"
  fi
  [ "$problems" -eq 0 ] && echo "doctor: no problems found" || { echo "doctor: $problems problem(s)"; return 1; }
}

cmd_validate() {
  need python3
  python3 -I "$REPO/scripts/validate.py" -q
  python3 -m unittest discover -s "$REPO/plugins/guardrails/tests" -q
  python3 -m unittest discover -s "$REPO/plugins/engineering/skills/requirement-traceability/scripts/tests" -q
}

case "${1:-}" in
  profiles) shift; cmd_profiles "$@" ;;
  install) shift; cmd_install "$@" ;;
  update) shift; cmd_update "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  validate) shift; cmd_validate "$@" ;;
  -h|--help|help|"") sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (see agent-skills --help)" ;;
esac
